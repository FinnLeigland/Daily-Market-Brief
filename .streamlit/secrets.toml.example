# Copy this file to .streamlit/secrets.toml and paste in your key from https://console.anthropic.com
# secrets.toml is git-ignored, so the key never ends up on GitHub.
ANTHROPIC_API_KEY = "sk-ant-..."

# Your own PIN for the Analyst Desk (default 2222). Set a longer one before publishing: the default is public in
# the code. A privacy screen, not bank-grade security.
DESK_PIN = "2222"

# Optional: daily alerts. A private ntfy topic (install the free ntfy app and subscribe to the same name)…
# NTFY_TOPIC = "pick-a-hard-to-guess-name"
# …and/or email (e.g. Gmail with an app password)
# SMTP_HOST = "smtp.gmail.com"
# SMTP_PORT = "587"
# SMTP_USER = "you@gmail.com"
# SMTP_PASSWORD = "app-password"
# ALERT_EMAIL_TO = "you@gmail.com"
